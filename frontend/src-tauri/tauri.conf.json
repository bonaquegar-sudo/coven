{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Coven",
  "version": "0.2.0",
  "identifier": "dev.coven.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Coven",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/coven-backend"
    ],
    "shortDescription": "Equipo de agentes de IA para auditar y corregir la seguridad de tu código",
    "publisher": "Coven"
  }
}